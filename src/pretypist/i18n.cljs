(def dictionaries
  {:en (m1p/prepare-dictionary en)
   :nb (m1p/prepare-dictionary nb)})

(defn locale [language]
  (if (= language :nb) :nb :en))

(defn t
  ([language key] (t language key nil))
  ([language key params]
   (m1p/lookup {} (get dictionaries (locale language)) key params)))

(defn localize [language data]
  (m1p/interpolate data {:dictionaries {:t (get dictionaries (locale language))}}))
