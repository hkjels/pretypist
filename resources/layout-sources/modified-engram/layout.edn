 :combos
 [{:id :clear-active-profile
   :layers #{:mouse}
   :keys [:k20 :k29]
   :timeout-ms 500
   :behavior :clear-profile-hold
   :hold-ms 700
   :action [:bluetooth :clear-selected-profile]
   :cancel-on-release true}]

 ;; Gesture steps describe the inferred physical sequence shown by PRETYPIST.
 ;; They are not raw browser telemetry. :hold/:release delimit momentary layers;
 ;; :tap, :double-tap, and :double-hold name the corresponding firmware gesture.
